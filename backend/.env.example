# Claude API (الوحيد الذي سيتم استخدامه للذكاء الاصطناعي)
ANTHROPIC_API_KEY=your_claude_api_key_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/content_machine

# Social Media Platforms (Keys & Tokens)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
FB_ACCESS_TOKEN=your_fb_access_token
IG_ACCESS_TOKEN=your_ig_access_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_SERVER_URL=https://your-ngrok-url.ngrok-free.app

# Scraper Settings
REQUEST_TIMEOUT=30

# Threads OAuth Integration
THREADS_CLIENT_ID=your_threads_app_id
THREADS_CLIENT_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=https://contanetmahcine.up.railway.app/auth/threads/callback
